# 환경변수 설정. 이 파일의 이름을 .env로 수정해서 사용하시오.
# 환경 변수에 원하는 값들을 입력해서 사용하시오.
BASE_DATA_PATH=
PM_HAZARD_THRESHOLD=
PM_ACTIVE=(True / False)
DOWN_ACTIVE=(True / False)
MACHINE_RULE=(SPTSSU)
JOB_RULE=(random / FIFO / SPT / LPT / MIN_QTIME / SPTSSU / COMPOSITE)
PM_RULE=(THRESHOLD)
TIME_UNIT=(M/H/D)
DOWN_TIME_UNIT=(M/H/D)

# --- COMPOSITE rule 파라미터 (JOB_RULE=COMPOSITE 일 때만 사용) ---
# Index Policy 선형결합 가중치. 모두 candidate 내 min-max 정규화 후 적용.
# α 항의 정의는 COMPOSITE_ALPHA_TERM으로 토글한다.
COMPOSITE_ALPHA_TERM=WAIT_TIME   # WAIT_TIME | CRITICAL_RATIO
COMPOSITE_ALPHA=1.0              # α-term (WAIT_TIME 또는 CRITICAL_RATIO)
COMPOSITE_BETA=1.0               # slack_qtime (qtime 위험도, 작을수록 우선)
COMPOSITE_GAMMA=1.0              # c_transition (다음 transition 위험 가중치)
COMPOSITE_DELTA=1.0              # setup time
