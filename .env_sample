# 환경변수 설정. 이 파일의 이름을 .env로 수정해서 사용하시오.
# 환경 변수에 원하는 값들을 입력해서 사용하시오.
BASE_DATA_PATH=
PM_HAZARD_THRESHOLD=
PM_ACTIVE=(True / False)
DOWN_ACTIVE=(True / False)
JOB_RULE=(random / FIFO / SPT / LPT / MIN_QTIME / SPTSSU / COMPOSITE)
PM_RULE=(THRESHOLD / AGE_REPLACEMENT / MTTF)
# MTTF rule 전용 (미지정 시 default 사용)
# MTTF_RISK_GROUPS={"G1": "medium", "G2": "low", "G3": "high", "G4": "high", "G5": "medium"}
# MTTF_RISK_COEFFICIENTS={"high": 0.3, "medium": 0.5, "low": 0.7}
TIME_UNIT=(M/H/D)


# --- COMPOSITE 6항 고정 계수 (result_test.ipynb 가 dynamic 모드로 읽음) ---
# 항 6개는 고정(PT/SLACK/SETUP/C_TRANSITION/COMPLETION_FAST/WAITING)이고,
# run_full6_pso.ipynb 의 w* 를 이 6개 숫자에 입력한다. scale-invariant (합=1 불필요).
COMPOSITE_W_PT=0.0
COMPOSITE_W_SLACK=0.0
COMPOSITE_W_SETUP=0.0
COMPOSITE_W_C_TRANSITION=0.0
COMPOSITE_W_COMPLETION_FAST=0.0
COMPOSITE_W_WAITING=0.0
