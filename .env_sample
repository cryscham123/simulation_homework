# 환경변수 설정. 이 파일의 이름을 .env로 수정해서 사용하시오.
# 환경 변수에 원하는 값들을 입력해서 사용하시오.
BASE_DATA_PATH=
PM_HAZARD_THRESHOLD=
PM_ACTIVE=(True / False)
DOWN_ACTIVE=(True / False)
JOB_RULE=(random / FIFO / SPT / LPT / MIN_QTIME / SPTSSU / COMPOSITE)
PM_RULE=(THRESHOLD / AGE_REPLACEMENT / MTTF)
# MTTF rule 전용 (미지정 시 default 사용)
# MTTF_RISK_GROUPS={"G1": "medium", "G2": "low", "G3": "high", "G4": "high", "G5": "medium"}
# MTTF_RISK_COEFFICIENTS={"high": 0.3, "medium": 0.5, "low": 0.7}
TIME_UNIT=(M/H/D)
DOWN_TIME_UNIT=(M/H/D)

# --- COMPOSITE rule 파라미터 (JOB_RULE=COMPOSITE 일 때만 사용) ---
# 가중치 (각 슬롯의 중요도. sum=1 simplex 위의 한 점이 표준)
COMPOSITE_ALPHA=1.0
COMPOSITE_BETA=1.0
COMPOSITE_GAMMA=1.0
COMPOSITE_DELTA=1.0
# 슬롯 -> 항(term) 매핑. 사용 가능: PT, SLACK, SETUP, C_TRANSITION,
#                                  COMPLETION_FAST, COMPLETION_SLOW, WAITING
COMPOSITE_ALPHA_TERM=PT
COMPOSITE_BETA_TERM=SLACK
COMPOSITE_GAMMA_TERM=C_TRANSITION
COMPOSITE_DELTA_TERM=SETUP
