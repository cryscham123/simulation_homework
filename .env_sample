# 환경변수 설정. 이 파일의 이름을 .env로 수정해서 사용하시오.
# 환경 변수에 원하는 값들을 입력해서 사용하시오.
BASE_DATA_PATH=
PM_HAZARD_THRESHOLD=
PM_ACTIVE=(True / False)
DOWN_ACTIVE=(True / False)
MACHINE_RULE=(SPTSSU)
JOB_RULE=(random / FIFO / SPT / LPT / MIN_QTIME / SPTSSU)
PM_RULE=(THRESHOLD/MTTF)
TIME_UNIT=(M/H/D)
DOWN_TIME_UNIT=(M/H/D)

# MTTF PM Rule Parameters (required if PM_RULE=MTTF)
# Machine group to risk type assignment: {"G1": "high", "G2": "medium", "G3": "low"}
MTTF_RISK_GROUPS={'G1': 'medium', 'G2': 'high', 'G3': 'low', 'G4': 'high', 'G5': 'medium'}

# Risk type to PM interval coefficient: {"high": 0.3, "medium": 0.5, "low": 0.7}
MTTF_RISK_COEFFICIENTS={"high": 0.3, "medium": 0.5, "low": 0.7}
