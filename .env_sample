# 환경변수 설정. 이 파일의 이름을 .env로 수정해서 사용하시오.
# 환경 변수에 원하는 값들을 입력해서 사용하시오.

# 공통 설정
BASE_DATA_PATH=
PM_ACTIVE=(True / False)
DOWN_ACTIVE=(True / False)
TIME_UNIT=(M/H/D)

# 룰베이스
PM_HAZARD_THRESHOLD=
JOB_RULE=(random / FIFO / SPT / LPT / MIN_QTIME / SPTSSU / COMPOSITE)
PM_RULE=(THRESHOLD / AGE_REPLACEMENT / MTTF)
# MTTF rule 전용 (미지정 시 default 사용)
# MTTF_RISK_GROUPS={"G1": "medium", "G2": "low", "G3": "high", "G4": "high", "G5": "medium"}
# MTTF_RISK_COEFFICIENTS={"high": 0.3, "medium": 0.5, "low": 0.7}

# --- COMPOSITE 6항 고정 계수 (result_test.ipynb 가 dynamic 모드로 읽음) ---
# 항 6개는 고정(PT/SLACK/SETUP/C_TRANSITION/COMPLETION_FAST/WAITING)이고,
# run_full6_pso.ipynb 의 w* 를 이 6개 숫자에 입력한다. scale-invariant (합=1 불필요).
COMPOSITE_W_PT=0.0
COMPOSITE_W_SLACK=0.0
COMPOSITE_W_SETUP=0.0
COMPOSITE_W_C_TRANSITION=0.0
COMPOSITE_W_COMPLETION_FAST=0.0
COMPOSITE_W_WAITING=0.0

# GA
PM_LEVELS=                  # pm threshold 값 (값 개수 바꿔도 적용 가능)
POP_SIZE=                   # 한 세대 집단 수
N_GENERATIONS=              # 세대 수
CROSSOVER_RATE=             # 교차 확률 (0.0 ~ 1.0)
MUT_JOB=                    # job_seq 유전자 mutation 확률 (0.0 ~ 1.0)
MUT_MACHINE=                # machine 유전자 mutation 확률 (0.0 ~ 1.0)
MUT_PM=                     # pm 유전자 mutation 확률 (0.0 ~ 1.0)
TOURNAMENT_K=               # 토너먼트 선택 후보 수 (양의 정수)
N_ELITES=                   # 엘리트 보존 개수 (다음 세대로 그대로 복사)
ALPHA=                      # fitness = makespan + α·qtime_violation 의 가중치
SEED=                       # 난수 시드 (정수). 비워두면 매 실행마다 랜덤 생성


STAGNATION_PATIENCE=        # 정체 감지 임계 세대 수. N세대 연속 best 개선이 없으면 boost 사이클 시작
MUTATION_BOOST=             # boost 모드일 때 mutation 확률에 곱할 배율 (예: 8.0 → 변이율 8배)
IMMIGRANT_RATIO=            # boost 모드일 때 population 하위 비율을 random으로 교체 (0.0 ~ 1.0)
BOOST_DURATION=             # boost ON 유지 세대 수. 이 기간 동안 변이/이주민 주입
BOOST_COOLDOWN=             # boost 종료 후 강제 OFF 세대 수. 새 변이가 정착할 시간을 확보

DOWN_TIME_UNIT=(M/H/D)
